# NEUQ 教务系统凭证（必填）
YOUR_NEUQ_USERNAME=你的学号
YOUR_NEUQ_PASSWORD=你的密码

# 教务系统 URL（可选，默认为官方地址）
# NEUQ_JWXT_BASE_URL=http://jwxt.neuq.edu.cn/eams/

# 是否通过学校 WebVPN 访问教务系统（校外网络环境下必须开启，默认 false）
# USE_WEBVPN=true

# WebVPN 地址（可选，默认为官方地址）
# NEUQ_WEBVPN_BASE_URL=https://vpn.neuq.edu.cn

# WebVPN 账号（可选，默认与教务系统用户名相同）
# 注意：WebVPN 使用统一身份认证账号密码
# WEBVPN_USERNAME=你的统一身份认证账号
# WEBVPN_PASSWORD=你的统一身份认证密码

# WebVPN 认证方式：cas（统一身份认证，默认）/ local（WebVPN 本地账号）
# WEBVPN_AUTH_TYPE=cas

# 请求超时时间（秒，默认 45）
# REQUEST_TIMEOUT_SECS=45

# 请求间隔时间（毫秒，默认 2000）
# REQUEST_DELAY_MS=2000

# 总共处理的天数（1-30，默认 7）
# TOTAL_DAYS=7

# 最大重试次数（默认 3）
# MAX_RETRIES=3

# 输出目录（默认 ./output）
# OUTPUT_DIR=./output

# 静态资源目录（默认 ./assets）
# ASSETS_DIR=./assets

# 是否覆盖已有数据（默认 false）
# FORCE_OVERWRITE=false

# 是否压缩 HTML 输出（默认 true）
# MINIFY_HTML=true
